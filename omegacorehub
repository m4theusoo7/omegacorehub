-- ==============================================================================
-- [3] MOTOR DE VOO INDETECTÁVEL (CURVAS DE BÉZIER)
-- ==============================================================================
-- Fórmula Matemática Bézier Quadrática: P(t) = (1-t)^2*P0 + 2(1-t)t*P1 + t^2*P2
local function CalcularPontoBezier(t, p0, p1, p2)
    return (1 - t)^2 * p0 + 2 * (1 - t) * t * p1 + t^2 * p2
end

local noclipCon
local function VooInteligenteBezier(targetCFrame)
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    local hrp = char.HumanoidRootPart

    -- Configura Noclip local para a viagem
    if noclipCon then noclipCon:Disconnect() end
    noclipCon = RunService.Stepped:Connect(function()
        if char then
            for _, p in pairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
            hrp.Velocity = Vector3.new(0, 0, 0)
        end
    end)

    local startPos = hrp.Position
    local endPos = targetCFrame.Position
    local distance = (startPos - endPos).Magnitude
    
    -- Se estiver muito perto, não precisa de curva
    if distance < 30 then
        hrp.CFrame = targetCFrame
        if noclipCon then noclipCon:Disconnect() end
        return true
    end

    -- Cria um ponto de controle aleatório no alto e pro lado para criar a curva do arco
    local offset = Vector3.new(math.random(-150, 150), math.random(100, 300), math.random(-150, 150))
    local controlPoint = startPos:Lerp(endPos, 0.5) + offset

    local tempoTotal = distance / 320 -- Velocidade base (ajuste se kikar)
    local tempoPassado = 0

    while tempoPassado < tempoTotal do
        if not getgenv().OmegaCoreAtivo then break end
        
        tempoPassado = tempoPassado + RunService.Heartbeat:Wait()
        local t = math.clamp(tempoPassado / tempoTotal, 0, 1)
        
        -- Interpolação de velocidade suave (Easing InOutQuad)
        local tOtimizado = t < 0.5 and 2 * t * t or 1 - math.pow(-2 * t + 2, 2) / 2
        
        local novaPos = CalcularPontoBezier(tOtimizado, startPos, controlPoint, endPos)
        hrp.CFrame = CFrame.new(novaPos, endPos) -- Voa olhando para o destino
    end

    if noclipCon then noclipCon:Disconnect() end
    return getgenv().OmegaCoreAtivo
end

-- ==============================================================================
-- [4] SISTEMA MEMORY-LEAK FREE SERVER HOP (PERSISTÊNCIA)
-- ==============================================================================
local function ExecutarServerHop()
    AtualizarRadar("Mudando de Servidor...", "Procurando mundo novo", 0)
    local Http = game:GetService("HttpService")
    local TPS = game:GetService("TeleportService")
    local ApiUrl = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    
    -- Gerencia o arquivo JSON de servidores visitados usando as funções do Executor
    local visitedFile = "OmegaCore_Visited.json"
    local visited = {}
    
    if isfile and isfile(visitedFile) then
        local data = readfile(visitedFile)
        local success, result = pcall(function() return Http:JSONDecode(data) end)
        if success then visited = result end
    end
    
    -- Limpa lista se ficar muito grande (>50) para evitar arquivo gigante
    if #visited > 50 then visited = {} end
    table.insert(visited, game.JobId)
    
    if writefile then
        writefile(visitedFile, Http:JSONEncode(visited))
    end

    local function Hop()
        local servers = Http:JSONDecode(game:HttpGet(ApiUrl))
        if servers and servers.data then
            for _, srv in pairs(servers.data) do
                if type(srv) == "table" and srv.playing < srv.maxPlayers - 1 and srv.id ~= game.JobId then
                    local jaVisitou = false
                    for _, id in pairs(visited) do
                        if id == srv.id then jaVisitou = true break end
                    end
                    
                    if not jaVisitou then
                        TPS:TeleportToPlaceInstance(game.PlaceId, srv.id, player)
                        task.wait(5)
                    end
                end
            end
        end
    end

    pcall(Hop)
    task.wait(3) -- Cooldown se falhar
end

