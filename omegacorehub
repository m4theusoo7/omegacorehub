local function SimularAtaque()
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
    for _, key in ipairs({Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V}) do
        VirtualInputManager:SendKeyEvent(true, key, false, game)
        VirtualInputManager:SendKeyEvent(false, key, false, game)
    end
end

local function ObterMelhorAlvo()
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local hrp = char.HumanoidRootPart

    -- 1. Checa Frutas dropadas no chão
    if PRIORIDADES.Frutas then
        for _, obj in pairs(Workspace:GetChildren()) do
            if obj:IsA("Tool") and string.find(obj.Name, "Fruit") then
                return {Tipo = "Fruta", Part = obj.Handle, Alvo = obj}
            end
        end
    end

    -- 2. Checa Bosses
    if Workspace:FindFirstChild("Enemies") then
        for _, enemy in pairs(Workspace.Enemies:GetChildren()) do
            for _, bossNome in ipairs(PRIORIDADES.Bosses) do
                if string.find(enemy.Name, bossNome) and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                    return {Tipo = "Boss", Part = enemy:FindFirstChild("HumanoidRootPart"), Alvo = enemy}
                end
            end
        end
    end

    -- 3. Checa Eventos (Pumpkins, etc)
    for _, obj in pairs(Workspace:GetDescendants()) do
        for _, evt in ipairs(PRIORIDADES.Eventos) do
            if obj.Name == evt then
                local tPart = obj:IsA("Model") and obj.PrimaryPart or (obj:IsA("BasePart") and obj or nil)
                if tPart then
                    return {Tipo = "Evento", Part = tPart, Alvo = obj}
                end
            end
        end
    end

    return nil
end

local function IniciarCerebro()
    while getgenv().OmegaCoreAtivo do
        local char = player.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then task.wait(1) continue end
        local hrp = char.HumanoidRootPart

        local decisao = ObterMelhorAlvo()

        if decisao then
            local dist = (hrp.Position - decisao.Part.Position).Magnitude
            AtualizarRadar("Caçando", decisao.Alvo.Name, dist)

            if dist > 20 then
                -- O deslocamento curvo (Bézier) evita triggers geométricos de hackers
                local alvoCFrame = decisao.Tipo == "Fruta" and decisao.Part.CFrame or decisao.Part.CFrame * CFrame.new(0, 8, 0)
                VooInteligenteBezier(alvoCFrame)
            else
                -- Combate / Coleta
                hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(decisao.Part.Position.X, hrp.Position.Y, decisao.Part.Position.Z))
                if decisao.Tipo ~= "Fruta" then
                    SimularAtaque()
                end
            end
        else
            if PRIORIDADES.MudarServidorVazio then
                ExecutarServerHop()
                task.wait(10) -- Aguarda o TeleportService
            else
                AtualizarRadar("Ocioso", "Nada encontrado", 0)
            end
        end
        task.wait(0.1)
    end
    AtualizarRadar("Desligado", nil, 0)
end

